# Copiez ce fichier en .env puis renseignez les valeurs. Le fichier .env ne doit jamais être versionné.

# Base de données (docker-compose)
POSTGRES_DB=donni
POSTGRES_USER=donni
POSTGRES_PASSWORD=changez-moi

# Port exposé par l'API
PORT=8080

# Secrets d'authentification : au moins 32 caractères aléatoires chacun
#   openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_PEPPER=

# Origines autorisées pour CORS, séparées par des virgules (vide : aucune)
CORS_ALLOWED_ORIGINS=

# Documentation OpenAPI (Swagger UI). Mettre false en production si l'API est publique.
SWAGGER_ENABLED=true

# Fuseau horaire utilisé par le serveur pour les envois planifiés
APP_TIMEZONE=Africa/Douala

# Notifications distantes Firebase Cloud Messaging (facultatif : laisser vide pour désactiver)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# WhatsApp Business Cloud API officielle (facultatif)
# WHATSAPP_MODE : disabled | mock | live
WHATSAPP_MODE=disabled
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Jeton exigé par POST /internal/whatsapp/dispatch (vide : le point d'entrée est refusé)
DISPATCH_TOKEN=

# Données de démonstration (profil Spring "demo")
# Mot de passe du compte de démonstration. Activer avec SPRING_PROFILES_ACTIVE=demo
SPRING_PROFILES_ACTIVE=
DEMO_PASSWORD=
